#pragma once

/* Copy this file to secrets.h and fill in real values. secrets.h is gitignored. */

#define WIFI_SSID     "your-wifi-name"
#define WIFI_PASSWORD "your-wifi-password"

/* Laptop LAN IP running Mosquitto — never "localhost"/127.0.0.1, the ESP32 is a
   separate device on the network. Find it with `ipconfig` on the laptop. */
#define MQTT_HOST "192.168.1.100"
#define MQTT_PORT 1883

/* No DEVICE_ID here — the firmware derives it from the chip's MAC at boot
   (e.g. "TL-B49244"), so this same file works unedited across every board
   at a site. Flash the same binary to as many boards as you want. */
