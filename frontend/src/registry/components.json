{
  "$comment": "Single source of truth for component identity, sprite geometry, and pin kinds. Adding an I2C sensor = an entry here, no firmware or JS change for identity (whoamiReg/whoamiVal: hex strings matching the WHOAMI <addr> <reg> reply) and, with optional readRegs, for data. readRegs = [{reg: hex string, len: 1..16 bytes, signed: bool, scale: multiplier, fields: reading names}]; len is split evenly across fields, each big-endian. Polling only reads: a chip that must be configured before it converts cannot stream this way. kind drives wire color and the wiring-correctness check. Optional display = which readings a part card shows ({key, label, unit, decimals, ring: {max}}); without it the card lists reads. esp32.header = the real pin rows drawn on the board, [label, gpio]. autoPlace:false = only added by hand.",
  "i2c": [
    {
      "id": "mpu6050",
      "label": "MPU6050",
      "candidateAddrs": [
        104,
        105
      ],
      "whoamiReg": "0x75",
      "whoamiVal": "0x68",
      "reads": [
        "ax",
        "ay",
        "az"
      ],
      "$readRegs": "1/4096 per LSB = the +-8g range the node firmware configures. Not polled on that firmware: its stream already owns these fields (adapter.streamKeys).",
      "readRegs": [
        {
          "reg": "0x3B",
          "len": 6,
          "signed": true,
          "scale": 0.000244140625,
          "fields": [
            "ax",
            "ay",
            "az"
          ]
        }
      ],
      "size": {
        "w": 270,
        "h": 170
      },
      "defaultPos": {
        "x": 470,
        "y": 44
      },
      "pins": [
        {
          "id": "VCC",
          "label": "VCC",
          "kind": "power",
          "dx": 0,
          "dy": 40
        },
        {
          "id": "GND",
          "label": "GND",
          "kind": "ground",
          "dx": 0,
          "dy": 68
        },
        {
          "id": "SCL",
