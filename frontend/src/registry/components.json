        {
          "id": "SDA",
          "label": "SDA",
          "kind": "signal",
          "dx": 0,
          "dy": 124
        }
      ],
      "display": [
        {
          "key": "vib",
          "label": "Vibration",
          "unit": "g",
          "decimals": 2
        }
      ]
    }
